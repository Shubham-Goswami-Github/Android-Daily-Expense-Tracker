<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    tools:context=".WelcomeActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Top Curved Background with Gradient -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="380dp"
                    android:background="@drawable/bg_welcome_header"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:paddingTop="60dp"
                    android:paddingBottom="40dp">

                    <!-- Logo Container -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="130dp"
                        android:layout_height="130dp"
                        app:cardCornerRadius="65dp"
                        app:cardElevation="12dp"
                        app:cardBackgroundColor="#FFFFFF">

                        <ImageView
                            android:id="@+id/logo"
                            android:layout_width="90dp"
                            android:layout_height="90dp"
                            android:layout_gravity="center"
                            android:contentDescription="App Logo"
                            android:scaleType="centerInside"
                            android:src="@drawable/logoft"/>

                    </com.google.android.material.card.MaterialCardView>

                    <!-- App Name -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="Finance Tracker"
                        android:textColor="#FFFFFF"
                        android:textSize="28sp"
                        android:fontFamily="sans-serif-bold"/>

                    <!-- Tagline -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Smart Money Management"
                        android:textColor="#E0E7FF"
                        android:textSize="14sp"
                        android:fontFamily="sans-serif-medium"/>

                </LinearLayout>

            </FrameLayout>

            <!-- Content Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp"
                android:layout_marginTop="-30dp">

                <!-- Welcome Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="8dp"
                    app:cardBackgroundColor="#FFFFFF">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="28dp">

                        <!-- Welcome Text -->
                        <TextView
                            android:id="@+id/textWelcome"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Welcome!"
                            android:textSize="24sp"
                            android:textColor="@color/text_primary"
                            android:fontFamily="sans-serif-bold"
                            android:textAlignment="center"/>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Take control of your finances with our easy-to-use expense tracker"
                            android:textSize="14sp"
                            android:textColor="@color/text_secondary"
                            android:textAlignment="center"
                            android:lineSpacingExtra="4dp"/>

                        <!-- Features Preview -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="28dp"
                            android:gravity="center">

                            <!-- Feature 1 -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:gravity="center">

                                <com.google.android.material.card.MaterialCardView
                                    android:layout_width="50dp"
                                    android:layout_height="50dp"
                                    app:cardCornerRadius="14dp"
                                    app:cardElevation="0dp"
                                    app:cardBackgroundColor="#DCFCE7">

                                    <ImageView
                                        android:layout_width="24dp"
                                        android:layout_height="24dp"
                                        android:layout_gravity="center"
                                        android:src="@drawable/ic_wallet"
                                        app:tint="#16A34A"/>

                                </com.google.android.material.card.MaterialCardView>

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:text="Track"
                                    android:textColor="@color/text_primary"
                                    android:textSize="12sp"
                                    android:fontFamily="sans-serif-medium"/>

                            </LinearLayout>

                            <!-- Feature 2 -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:gravity="center">

                                <com.google.android.material.card.MaterialCardView
                                    android:layout_width="50dp"
                                    android:layout_height="50dp"
                                    app:cardCornerRadius="14dp"
                                    app:cardElevation="0dp"
                                    app:cardBackgroundColor="#DBEAFE">

                                    <ImageView
                                        android:layout_width="24dp"
                                        android:layout_height="24dp"
                                        android:layout_gravity="center"
                                        android:src="@drawable/ic_statistics"
                                        app:tint="#2563EB"/>

                                </com.google.android.material.card.MaterialCardView>

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:text="Analyze"
                                    android:textColor="@color/text_primary"
                                    android:textSize="12sp"
                                    android:fontFamily="sans-serif-medium"/>

                            </LinearLayout>

                            <!-- Feature 3 -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:gravity="center">

                                <com.google.android.material.card.MaterialCardView
                                    android:layout_width="50dp"
                                    android:layout_height="50dp"
                                    app:cardCornerRadius="14dp"
                                    app:cardElevation="0dp"
                                    app:cardBackgroundColor="#FEF3C7">

                                    <ImageView
                                        android:layout_width="24dp"
                                        android:layout_height="24dp"
                                        android:layout_gravity="center"
                                        android:src="@drawable/ic_savings"
                                        app:tint="#D97706"/>

                                </com.google.android.material.card.MaterialCardView>

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:text="Save"
                                    android:textColor="@color/text_primary"
                                    android:textSize="12sp"
                                    android:fontFamily="sans-serif-medium"/>

                            </LinearLayout>

                        </LinearLayout>

                        <!-- Divider -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginVertical="28dp"
                            android:background="#F1F5F9"/>

                        <!-- Login Button -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnLogin"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:text="Login"
                            android:textSize="16sp"
                            android:textAllCaps="false"
                            android:textColor="#FFFFFF"
                            android:fontFamily="sans-serif-bold"
                            app:backgroundTint="@color/primary_blue"
                            app:cornerRadius="16dp"
                            app:icon="@drawable/ic_login"
                            app:iconGravity="textStart"
                            app:iconPadding="12dp"
                            app:iconTint="#FFFFFF"/>

                        <!-- Register Button -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnRegister"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:layout_marginTop="12dp"
                            android:text="Create Account"
                            android:textSize="16sp"
                            android:textAllCaps="false"
                            android:textColor="@color/primary_blue"
                            android:fontFamily="sans-serif-bold"
                            app:backgroundTint="#FFFFFF"
                            app:cornerRadius="16dp"
                            app:strokeColor="@color/primary_blue"
                            app:strokeWidth="2dp"
                            app:icon="@drawable/ic_person_add"
                            app:iconGravity="textStart"
                            app:iconPadding="12dp"
                            app:iconTint="@color/primary_blue"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- Developer Info Footer -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginTop="32dp"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Version 1.0.0"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"/>

                    <TextView
                        android:id="@+id/textDeveloperInfo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Made with ❤️ by Shubham &amp; Yashansii"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif-medium"/>

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>